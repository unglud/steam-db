# Copy to .env and edit. Empty values use defaults from src/config.ts.

# Store data
STEAM_COUNTRY=MY
STEAM_LANG=english
STEAM_MYR_TO_EUR_RATE=0.2145

# Runtime limits. Use all or null for no limit where supported.
STEAM_START=0
STEAM_PAGES=all
STEAM_LIMIT=all
STEAM_MAX_CANDIDATES=all
STEAM_CONCURRENCY=1

# Output
STEAM_OUTPUT_MODE=json
# Use null/none/stdout to print to stdout instead of writing a file.
STEAM_GAMES_OUTPUT_FILE=steam-games.json
STEAM_OUTPUT_RETENTION_ENABLED=true
STEAM_OUTPUT_RETENTION_KEEP_LAST=10
STEAM_PROGRESS=true
STEAM_VERBOSE=true

# Cache
STEAM_CACHE_ENABLED=true
STEAM_GAMES_CACHE_DIR=.cache/steam
STEAM_CACHE_CLEANUP_EXPIRED=true
STEAM_CACHE_SEARCH_TTL_HOURS=24
STEAM_CACHE_APP_DETAILS_TTL_HOURS=24
STEAM_CACHE_DEMO_PAGE_TTL_HOURS=168
STEAM_CACHE_REVIEW_SUMMARY_TTL_HOURS=72

# Request pacing and retry
STEAM_REQUEST_SEARCH_DELAY_MS=1000
STEAM_REQUEST_APP_DETAILS_DELAY_MS=1500
STEAM_REQUEST_REVIEW_SUMMARY_DELAY_MS=500
STEAM_RETRY_MAX_ATTEMPTS=8
STEAM_RETRY_BASE_DELAY_MS=3000
STEAM_RETRY_MAX_DELAY_MS=120000

# Filters
STEAM_FILTER_DISPLAY_ONLY=Game
STEAM_FILTER_MIN_DISCOUNT=25
STEAM_FILTER_MIN_RATING=0
STEAM_FILTER_MIN_RELEASE=2000-01-01
STEAM_FILTER_MIN_REVIEWS=500
# Use win, mac, linux, applesilicon, or all.
STEAM_FILTER_OS=mac
STEAM_FILTER_SORT=demo_positive_desc
STEAM_FILTER_INCLUDE_TAGS=
STEAM_FILTER_EXCLUDE_TAGS=1625,1664,3799,3843,3859,5537,7178
STEAM_FILTER_IGNORE_NAMES=Undertale,Hades,Soulstone Survivors,Nova Drift
STEAM_FILTER_TERM=

# Server / Docker
HOST=0.0.0.0
PORT=3000
STEAM_GAMES_INTERVAL_HOURS=24
