{
  "name": "steam-db",
  "version": "0.1.0",
  "description": "Steam deals JSON crawler for discounted games, reviews, demos, and sale filters.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "steam",
    "steam-store",
    "steam-deals",
    "steam-sales",
    "steam-discounts",
    "steam-sale-tracker",
    "steam-crawler",
    "games",
    "game-deals",
    "sales",
    "json",
    "typescript",
    "docker"
  ],
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "games": "node --env-file-if-exists=.env src/steam-games.ts",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --test test/*.test.ts"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
